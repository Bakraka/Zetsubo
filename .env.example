# Required: Bot token from the Discord Developer Portal
DISCORD_TOKEN=put-your-discord-bot-token-here

# Optional: enables the /ask OpenRouter slash command
OPENROUTER_API_KEY=
# Optional model override; defaults to this currently listed free model
OPENROUTER_MODEL=google/gemma-4-31b-it:free

# Optional: set this to the mount path of a Railway Volume, usually /data
# RAILWAY_VOLUME_MOUNT_PATH=/data
